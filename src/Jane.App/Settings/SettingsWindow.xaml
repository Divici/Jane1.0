<Window x:Class="Jane.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Jane.App.Controls"
        xmlns:s="clr-namespace:Jane.App.Settings"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="Jane settings"
        Width="1080"
        Height="780"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        FontSize="13"
        FontFamily="{x:Static c:JaneTheme.UiFont}"
        Foreground="{x:Static c:JaneTheme.TextPrimary}"
        Background="{x:Static c:JaneTheme.WindowBackground}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Jane;component/Controls/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{x:Static c:JaneTheme.WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================== Header ============================== -->
        <Border x:Name="ChromeBar"
                Grid.Row="0"
                Background="{x:Static c:JaneTheme.NavBackground}"
                BorderBrush="{x:Static c:JaneTheme.Border}"
                BorderThickness="0,0,0,1"
                Padding="24,16,20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource Display}" Text="Jane" />
                    <TextBlock Style="{StaticResource Secondary}"
                               Margin="0,3,0,0"
                               FontSize="12"
                               Text="Push-to-talk dictation that runs entirely on this machine. Nothing here leaves it." />
                </StackPanel>

                <Button Grid.Column="1"
                        x:Name="CloseButton"
                        Style="{StaticResource JaneButton}"
                        VerticalAlignment="Center"
                        IsCancel="True"
                        Content="_Close"
                        AutomationProperties.AutomationId="SettingsClose"
                        AutomationProperties.Name="Close the settings window"
                        Click="OnCloseClick" />
            </Grid>
        </Border>

        <!-- =========================== Left navigation ======================== -->
        <TabControl x:Name="Nav"
                    Grid.Row="1"
                    Style="{StaticResource JaneNav}"
                    KeyboardNavigation.TabNavigation="Local"
                    SelectionChanged="OnSectionChanged">

            <!-- ============================ Dictation ========================= -->
            <TabItem Header="Dictation"
                     Tag="{x:Static s:SettingsSection.Dictation}"
                     AutomationProperties.Name="Dictation settings">
                <ScrollViewer Style="{StaticResource JaneScrollViewer}">
                    <StackPanel Margin="{StaticResource PadPage}" MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource Display}" Text="Dictation" />
                        <TextBlock Style="{StaticResource Secondary}"
                                   Margin="0,6,0,20"
                                   Text="How you start and stop talking. Jane listens for one key anywhere in Windows, using a low-level keyboard hook rather than a registered hotkey, which is the only way a bare modifier can be observed being held." />

                        <c:SettingsGroup Header="Push-to-talk key">
                            <StackPanel>
                                <c:SettingRow Header="Key"
                                              Description="Hold it, speak, let go. Jane will use it in every application, including ones running as administrator once the binary is signed."
                                              Note="{Binding HotkeyStatus.Message}"
                                              NoteSeverity="{Binding HotkeyStatusSeverity}">
                                    <StackPanel Orientation="Horizontal">
                                        <s:HotkeyPicker x:Name="Picker"
                                                        Style="{StaticResource JaneButton}"
                                                        MinWidth="150"
                                                        Binding="{Binding Hotkey, Mode=OneWay}"
                                                        AutomationProperties.AutomationId="HotkeyPicker"
                                                        Captured="OnHotkeyCaptured" />
                                        <Button Style="{StaticResource JaneQuietButton}"
                                                Margin="8,0,0,0"
                                                Content="Reset"
                                                AutomationProperties.Name="Reset the push-to-talk key to Right Ctrl"
                                                Click="OnResetHotkey" />
                                    </StackPanel>
                                </c:SettingRow>

                                <c:SettingRow Header="Activation"
                                              Description="{Binding ModeChoiceValue.Description}">
                                    <ComboBox Style="{StaticResource JaneComboBox}"
                                              MinWidth="220"
                                              ItemsSource="{Binding Modes}"
                                              SelectedItem="{Binding ModeChoiceValue}"
                                              AutomationProperties.AutomationId="HotkeyMode"
                                              AutomationProperties.Name="How the hotkey activates dictation" />
                                </c:SettingRow>

                                <c:SettingRow Header="Minimum hold"
                                              Description="Holds shorter than this cancel silently -- no overlay, no models, no text. It is what stops a stray brush of the key, or a game bind, from firing a dictation.">
                                    <StackPanel Orientation="Horizontal">
                                        <Slider Style="{StaticResource JaneSlider}"
                                                Width="220"
                                                Minimum="0"
                                                Maximum="1000"
                                                TickFrequency="25"
                                                Value="{Binding MinimumHoldMs}"
                                                AutomationProperties.AutomationId="MinimumHold"
                                                AutomationProperties.Name="Minimum hold in milliseconds" />
                                        <TextBlock Style="{StaticResource Mono}"
                                                   Width="66"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Right"
                                                   Text="{Binding MinimumHoldMs, StringFormat={}{0} ms}" />
                                    </StackPanel>
                                </c:SettingRow>

                                <c:SettingRow Header="Maximum dictation length"
                                              Description="A hard cap on one capture. It matters most in press-to-start mode, where a dictation left running would otherwise grow a buffer until the machine gave out; at the cap, the audio so far is kept and the pipeline runs.">
                                    <StackPanel Orientation="Horizontal">
                                        <Slider Style="{StaticResource JaneSlider}"
                                                Width="220"
                                                Minimum="10"
                                                Maximum="900"
                                                TickFrequency="10"
                                                Value="{Binding MaxToggleSeconds}"
                                                AutomationProperties.AutomationId="MaxDuration"
                                                AutomationProperties.Name="Maximum dictation length in seconds" />
                                        <TextBlock Style="{StaticResource Mono}"
                                                   Width="66"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Right"
                                                   Text="{Binding MaxToggleSeconds, StringFormat={}{0} s}" />
                                    </StackPanel>
                                </c:SettingRow>

                                <c:SettingRow Header="Listen while a game is in front"
                                              Description="Off by default. Right Ctrl is a common push-to-talk bind, and a dictation starting mid-firefight is worse than one that does not start at all. The tray's Pause item does the same thing for one session.">
                                    <CheckBox Style="{StaticResource JaneSwitch}"
                                              IsChecked="{Binding HotkeyEnabledInGame}"
                                              AutomationProperties.AutomationId="HotkeyInGame"
                                              AutomationProperties.Name="Listen for the hotkey while a game is in the foreground" />
                                </c:SettingRow>
                            </StackPanel>
                        </c:SettingsGroup>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================== Audio =========================== -->
            <TabItem Header="Microphone"
                     Tag="{x:Static s:SettingsSection.Audio}"
                     AutomationProperties.Name="Microphone settings">
                <ScrollViewer Style="{StaticResource JaneScrollViewer}">
                    <StackPanel Margin="{StaticResource PadPage}" MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource Display}" Text="Microphone" />
                        <TextBlock Style="{StaticResource Secondary}"
                                   Margin="0,6,0,20"
                                   Text="Jane opens the microphone in shared mode and never takes the endpoint away from a call. By default it only opens it while you are actually dictating." />

                        <c:SettingsGroup Header="Input device"
                                         Description="Leaving this on the Windows default means swapping headsets re-routes without Jane being told. Naming a device pins it.">
                            <StackPanel>
                                <c:SettingRow Header="Device">
                                    <StackPanel Orientation="Horizontal">
                                        <ComboBox Style="{StaticResource JaneComboBox}"
                                                  MinWidth="300"
                                                  ItemsSource="{Binding Microphones}"
                                                  SelectedItem="{Binding Microphone}"
                                                  AutomationProperties.AutomationId="MicrophoneChoice"
                                                  AutomationProperties.Name="Microphone Jane records from" />
                                        <Button Style="{StaticResource JaneQuietButton}"
                                                Margin="8,0,0,0"
                                                Content="Refresh"
                                                AutomationProperties.Name="Re-scan for microphones"
                                                Click="OnRefreshMicrophones" />
                                    </StackPanel>
                                </c:SettingRow>

                                <c:StatePanel Glyph="&#xE720;"
                                              Title="No microphone found"
                                              Severity="Warning"
                                              Description="Windows reports no active capture endpoint. Plug one in and press Refresh, or enable it under Settings, System, Sound, Input. Jane cannot dictate without one."
                                              Visibility="{Binding HasNoMicrophone, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </c:SettingsGroup>

                        <c:SettingsGroup Header="When Jane listens"
                                         Description="Holding the microphone open costs more than an icon on a Bluetooth headset: Windows drops the headset into its narrowband call profile for as long as any app is capturing, and everything you play through it sounds worse until the app lets go. Whichever setting you choose, Jane opts out of the attenuation Windows applies to other apps while a communications microphone is live, so your music does not drop each time you dictate.">
                            <StackPanel>
                                <c:SettingRow Header="Open the microphone">
                                    <ComboBox Style="{StaticResource JaneComboBox}"
                                              MinWidth="300"
                                              ItemsSource="{Binding Activations}"
                                              SelectedItem="{Binding MicrophoneActivationChoice}"
                                              AutomationProperties.AutomationId="MicrophoneActivation"
                                              AutomationProperties.Name="When Jane opens the microphone" />
                                </c:SettingRow>

                                <TextBlock Style="{StaticResource Secondary}"
                                           Margin="0,0,0,12"
                                           TextWrapping="Wrap"
                                           Text="{Binding MicrophoneActivationChoice.Description}" />

                                <c:SettingRow Header="Keep it open afterwards"
                                              Description="Seconds to hold the microphone after a dictation ends. A run of quick dictations then pays the start-up cost once instead of once each, and every one after the first keeps its half-second of pre-roll. Zero releases it immediately."
                                              Visibility="{Binding IsMicrophoneOnDemand, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Slider Style="{StaticResource JaneSlider}"
                                                Width="220"
                                                Minimum="0"
                                                Maximum="60"
                                                TickFrequency="1"
                                                Value="{Binding MicrophoneIdleReleaseSeconds}"
                                                AutomationProperties.AutomationId="MicrophoneIdleRelease"
                                                AutomationProperties.Name="Seconds to keep the microphone open after a dictation" />
                                        <TextBlock Style="{StaticResource Mono}"
                                                   Width="66"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Right"
                                                   Text="{Binding MicrophoneIdleReleaseSeconds, StringFormat={}{0} s}" />
                                    </StackPanel>
                                </c:SettingRow>
                            </StackPanel>
                        </c:SettingsGroup>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================== Engine ========================== -->
            <TabItem Header="Speech engine"
                     Tag="{x:Static s:SettingsSection.Engine}"
                     AutomationProperties.Name="Speech engine settings">
                <ScrollViewer Style="{StaticResource JaneScrollViewer}">
                    <StackPanel Margin="{StaticResource PadPage}" MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource Display}" Text="Speech engine" />
                        <TextBlock Style="{StaticResource Secondary}"
                                   Margin="0,6,0,20"
                                   Text="Speech recognition runs on the CPU, in this process, holding no VRAM at all. That is what leaves the graphics card free while you game, and it is measured rather than assumed -- `bench` runs both engines on this machine and writes the winner here." />

                        <c:SettingsGroup Header="Engine">
                            <StackPanel>
                                <c:SettingRow Header="Recogniser" Description="{Binding Engine.Description}">
                                    <ComboBox Style="{StaticResource JaneComboBox}"
                                              MinWidth="300"
                                              ItemsSource="{Binding Engines}"
                                              SelectedItem="{Binding Engine}"
                                              AutomationProperties.AutomationId="EngineChoice"
                                              AutomationProperties.Name="Speech recognition engine" />
                                </c:SettingRow>

                                <TextBlock Style="{StaticResource Caption}"
                                           Margin="0,0,0,14"
                                           Text="{Binding BenchmarkedAtDescription}" />

                                <c:SettingRow Header="Threads"
                                              Description="Four is the measured optimum on this machine, and not because more is worse at length: eight threads is faster on a ten-second utterance and slower on a one-second one, because thread-pool spin-up dominates a short clip. Dictation is mostly short.">
                                    <StackPanel Orientation="Horizontal">
                                        <Slider Style="{StaticResource JaneSlider}"
                                                Width="200"
                                                Minimum="1"
                                                Maximum="16"
                                                TickFrequency="1"
                                                Value="{Binding NumThreads}"
                                                AutomationProperties.AutomationId="NumThreads"
                                                AutomationProperties.Name="Recognition threads" />
                                        <TextBlock Style="{StaticResource Mono}"
                                                   Width="40"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Right"
                                                   Text="{Binding NumThreads}" />
                                    </StackPanel>
                                </c:SettingRow>

                                <c:SettingRow Header="Bias toward your dictionary"
                                              Description="Feeds your terms to the recogniser as contextual biasing hotwords. It forces beam search in place of greedy decoding, which measured at 88% of greedy's median on this machine -- cheap enough to leave on.">
                                    <CheckBox Style="{StaticResource JaneSwitch}"
                                              IsChecked="{Binding HotwordBiasing}"
                                              AutomationProperties.AutomationId="HotwordBiasing"
                                              AutomationProperties.Name="Bias recognition toward custom dictionary terms" />
                                </c:SettingRow>
                            </StackPanel>
                        </c:SettingsGroup>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================== Models ========================== -->
            <TabItem Header="Models"
                     Tag="{x:Static s:SettingsSection.Models}"
                     AutomationProperties.Name="Model management">
                <ScrollViewer Style="{StaticResource JaneScrollViewer}">
                    <StackPanel Margin="{StaticResource PadPage}" MaxWidth="880" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource Display}" Text="Models" />
                        <TextBlock Style="{StaticResource Secondary}"
                                   Margin="0,6,0,20"
                                   Text="The only time Jane uses the network. Each download is pinned by URL and verified against a SHA-256 in the source before anything is unpacked, and a partial download resumes where it stopped." />

                        <ItemsControl ItemsSource="{Binding Models}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,12"
                                            Padding="{StaticResource PadCard}"
                                            CornerRadius="{StaticResource CornerCard}"
                                            Background="{x:Static c:JaneTheme.Surface}"
                                            BorderBrush="{x:Static c:JaneTheme.Border}"
                                            BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Title}" FontSize="14" Text="{Binding Title}" VerticalAlignment="Center" />
                                                    <c:Badge Margin="10,0,0,0" VerticalAlignment="Center" Content="{Binding SizeDescription}" />
                                                    <c:Badge Margin="6,0,0,0" VerticalAlignment="Center" Content="{Binding License}" Severity="Success" />
                                                    <c:Badge Margin="6,0,0,0"
                                                             VerticalAlignment="Center"
                                                             Content="Required"
                                                             Severity="Warning"
                                                             Visibility="{Binding Required, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource Secondary}" Margin="0,6,0,0" FontSize="12" Text="{Binding Role}" />
                                                <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="{Binding Attribution}" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Top">
                                                <TextBlock Style="{StaticResource Caption}"
                                                           HorizontalAlignment="Right"
                                                           Margin="0,0,0,7"
                                                           AutomationProperties.LiveSetting="Polite"
                                                           Foreground="{Binding StatusSeverity, Converter={StaticResource SeverityBrush}}"
                                                           Text="{Binding StatusText}" />
                                                <Button Style="{StaticResource JaneButton}"
                                                        HorizontalAlignment="Right"
                                                        MinWidth="120"
                                                        Command="{Binding Download}"
                                                        AutomationProperties.Name="{Binding Title, StringFormat='Download {0}'}">
                                                    <TextBlock>
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                                                                <Setter Property="Text" Value="Download" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CanRetry}" Value="True">
                                                                        <Setter Property="Text" Value="Retry" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                                        <Setter Property="Text" Value="Downloading" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                                        <Setter Property="Text" Value="Installed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Button>
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                                                <ProgressBar Style="{StaticResource JaneProgress}"
                                                             Margin="0,14,0,0"
                                                             Minimum="0"
                                                             Maximum="100"
                                                             Value="{Binding ProgressPercent, Mode=OneWay}"
                                                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                                                <Border Margin="0,14,0,0"
                                                        Padding="12,10,12,10"
                                                        CornerRadius="{StaticResource CornerControl}"
                                                        Background="{x:Static c:JaneTheme.DangerWash}"
                                                        Visibility="{Binding ErrorRemedy, Converter={StaticResource EmptyToCollapsed}}">
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource Label}"
                                                                   FontSize="12"
                                                                   Foreground="{x:Static c:JaneTheme.Danger}"
                                                                   Text="This download did not finish" />
                                                        <TextBlock Style="{StaticResource Secondary}"
                                                                   Margin="0,5,0,0"
                                                                   FontSize="12"
                                                                   AutomationProperties.LiveSetting="Assertive"
                                                                   Text="{Binding ErrorRemedy}" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================ Formatting ======================== -->
            <TabItem Header="Formatting"
                     Tag="{x:Static s:SettingsSection.Formatting}"
                     AutomationProperties.Name="Formatting and GPU settings">
                <ScrollViewer Style="{StaticResource JaneScrollViewer}">
                    <StackPanel Margin="{StaticResource PadPage}" MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource Display}" Text="Formatting" />
                        <TextBlock Style="{StaticResource Secondary}"
                                   Margin="0,6,0,20"
                                   Text="A local language model cleans the transcript: filler removed, spoken self-corrections resolved, your instructions applied. It is the only part of Jane that touches the graphics card, and it lets go of it the moment you stop." />

                        <c:SettingsGroup Header="Language model">
                            <StackPanel>
                                <c:SettingRow Header="Clean up transcripts"
                                              Description="Off means Jane injects the raw transcript. That is not a downgrade to nothing: the recogniser already emits punctuation and casing, which is exactly why the in-game route can skip this step.">
                                    <CheckBox Style="{StaticResource JaneSwitch}"
                                              IsChecked="{Binding LlmEnabled}"
                                              AutomationProperties.AutomationId="LlmEnabled"
                                              AutomationProperties.Name="Clean up transcripts with the language model" />
                                </c:SettingRow>

                                <c:SettingRow Header="Use the Ollama I run myself"
                                              Description="Off, Jane supervises its own copy on port 11435 and shuts it down with itself. On, Jane talks to whatever is already listening on 11434 and starts nothing — it saves you a second 1.4 GB download and a second copy of every model, and costs you Jane's promise to give the graphics card back and to keep the machine quiet.">
                                    <CheckBox Style="{StaticResource JaneSwitch}"
                                              IsChecked="{Binding UseSystemOllama}"
                                              AutomationProperties.AutomationId="UseSystemOllama"
                                              AutomationProperties.Name="Use the Ollama I run myself instead of Jane's own copy" />
                                </c:SettingRow>

                                <c:SettingRow Header="Release the GPU after"
                                              Description="Jane sends one explicit unload this long after your last dictation, with a watchdog that kills the model if it is still resident afterwards.">
                                    <StackPanel Orientation="Horizontal">
                                        <Slider Style="{StaticResource JaneSlider}"
                                                Width="200"
                                                Minimum="10"
                                                Maximum="900"
                                                TickFrequency="10"
                                                Value="{Binding IdleUnloadSeconds}"
                                                AutomationProperties.AutomationId="IdleUnload"
                                                AutomationProperties.Name="Seconds of idle before the model is unloaded" />
                                        <TextBlock Style="{StaticResource Mono}"
                                                   Width="56"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Right"
                                                   Text="{Binding IdleUnloadSeconds, StringFormat={}{0} s}" />
                                    </StackPanel>
                                </c:SettingRow>
                            </StackPanel>
                        </c:SettingsGroup>

                        <c:SettingsGroup Header="Spacing"
                                         Description="Jane types at the cursor and adds nothing of its own, which is right for the first dictation and wrong for the second.">
                            <StackPanel>
                                <c:SettingRow Header="Separate consecutive dictations"
                                              Description="Puts a space in front of a dictation that follows another into the same window, so pausing mid-thought does not produce &quot;Hello there.How are you?&quot;. Jane leaves the text alone wherever it cannot be sure -- a different window, the first dictation of a session, or text that starts with punctuation.">
                                    <CheckBox Style="{StaticResource JaneSwitch}"
                                              IsChecked="{Binding AutoSpace}"
                                              AutomationProperties.AutomationId="AutoSpace"
                                              AutomationProperties.Name="Separate consecutive dictations with a space" />
                                </c:SettingRow>
                            </StackPanel>
                        </c:SettingsGroup>

                        <c:SettingsGroup Header="Numbers and symbols"
                                         Description="The speech engine writes what it heard, so a number or a symbol arrives as a word unless something turns it back. Jane does that itself, on every dictation, whether or not the language model runs.">
                            <StackPanel>
                                <c:SettingRow Header="Numbers" Description="{Binding NumberStyleChoiceValue.Description}">
                                    <ComboBox Style="{StaticResource JaneComboBox}"
                                              MinWidth="240"
                                              ItemsSource="{Binding NumberStyleChoices}"
                                              SelectedItem="{Binding NumberStyleChoiceValue}"
                                              AutomationProperties.AutomationId="NumberStyle"
                                              AutomationProperties.Name="How spoken numbers are written" />
                                </c:SettingRow>
                                <c:SettingRow Header="Type symbols when they are named"
                                              Description="Saying &quot;three slash four&quot; types 3/4, and &quot;hello comma world period&quot; types &quot;hello, world.&quot; Covers comma, period, full stop, colon, semicolon, question mark, exclamation mark, dash, hyphen, slash, backslash, new line and new paragraph. Jane leaves the word alone when you are talking about the symbol, as in &quot;add a comma&quot;.">
                                    <CheckBox Style="{StaticResource JaneSwitch}"
                                              IsChecked="{Binding SpokenSymbols}"
                                              AutomationProperties.AutomationId="SpokenSymbols"
                                              AutomationProperties.Name="Type a symbol when its name is spoken" />
                                </c:SettingRow>
                            </StackPanel>
                        </c:SettingsGroup>

                        <c:SettingsGroup Header="While you are gaming"
                                         Description="Jane decides the GPU is busy from three signals combined, because no one of them is enough: the shell's notification state only sees exclusive fullscreen, and most modern games are borderless-windowed.">
                            <StackPanel>
                                <c:SettingRow Header="Behaviour" Description="{Binding InGameChoiceValue.Description}">
                                    <ComboBox Style="{StaticResource JaneComboBox}"
                                              MinWidth="240"
                                              ItemsSource="{Binding InGameChoices}"
                                              SelectedItem="{Binding InGameChoiceValue}"
                                              AutomationProperties.AutomationId="InGameBehaviour"
                                              AutomationProperties.Name="What Jane does with the language model while a game is running" />
                                </c:SettingRow>

                                <c:SettingRow Header="Keep this much VRAM free"
                                              Description="Below this, the card counts as contended even with no game detected. Loading a 2.5 GB model into the last of somebody's VRAM is how you cause a stutter in something else.">
                                    <StackPanel Orientation="Horizontal">
                                        <Slider Style="{StaticResource JaneSlider}"
                                                Width="200"
                                                Minimum="0"
                                                Maximum="24"
                                                TickFrequency="1"
                                                Value="{Binding MinimumFreeVramGb}"
                                                AutomationProperties.AutomationId="MinimumFreeVram"
                                                AutomationProperties.Name="Minimum free video memory in gigabytes" />
                                        <TextBlock Style="{StaticResource Mono}"
                                                   Width="56"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Right"
                                                   Text="{Binding MinimumFreeVramGb, StringFormat={}{0:0} GB}" />
                                    </StackPanel>
                                </c:SettingRow>

                                <c:SettingRow Header="Busy above"
                                              Description="GPU utilisation, read from NVML, above which Jane treats the card as in use.">
                                    <StackPanel Orientation="Horizontal">
                                        <Slider Style="{StaticResource JaneSlider}"
                                                Width="200"
                                                Minimum="0"
                                                Maximum="100"
                                                TickFrequency="5"
                                                Value="{Binding BusyUtilisationPercent}"
                                                AutomationProperties.AutomationId="BusyUtilisation"
                                                AutomationProperties.Name="GPU utilisation percentage that counts as busy" />
                                        <TextBlock Style="{StaticResource Mono}"
                                                   Width="56"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Right"
                                                   Text="{Binding BusyUtilisationPercent, StringFormat={}{0} %}" />
                                    </StackPanel>
                                </c:SettingRow>

                                <c:SettingRow Header="Use NVML"
                                              Description="Utilisation and free memory, read from the display driver. No CUDA toolkit needed.">
                                    <CheckBox Style="{StaticResource JaneSwitch}"
                                              IsChecked="{Binding TrustNvml}"
                                              AutomationProperties.AutomationId="TrustNvml"
                                              AutomationProperties.Name="Use NVML GPU readings" />
                                </c:SettingRow>

                                <c:SettingRow Header="Use fullscreen geometry"
                                              Description="Whether the foreground window covers a whole monitor. This is the signal that catches borderless-windowed games.">
                                    <CheckBox Style="{StaticResource JaneSwitch}"
                                              IsChecked="{Binding TrustFullscreenGeometry}"
                                              AutomationProperties.AutomationId="TrustFullscreen"
                                              AutomationProperties.Name="Use fullscreen window geometry as a busy signal" />
                                </c:SettingRow>

                                <c:SettingRow Header="Use the shell's notification state"
                                              Description="Windows' own &quot;presentation mode&quot; flag. It only sees exclusive fullscreen, so it is the weakest of the three and never used alone.">
                                    <CheckBox Style="{StaticResource JaneSwitch}"
                                              IsChecked="{Binding TrustNotificationState}"
                                              AutomationProperties.AutomationId="TrustNotificationState"
                                              AutomationProperties.Name="Use the shell notification state as a busy signal" />
                                </c:SettingRow>
                            </StackPanel>
                        </c:SettingsGroup>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- =========================== Deep Context ======================= -->
            <TabItem Header="Deep Context"
                     Tag="{x:Static s:SettingsSection.DeepContext}"
                     AutomationProperties.Name="Deep Context and blocklist">
                <ScrollViewer Style="{StaticResource JaneScrollViewer}">
                    <StackPanel Margin="{StaticResource PadPage}" MaxWidth="880" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource Display}" Text="Deep Context" />
                        <TextBlock Style="{StaticResource Secondary}"
                                   Margin="0,6,0,20"
                                   Text="Jane reads the focused window's text through Windows' accessibility APIs, so it knows the names and jargon already on screen. Anything it reads is stored in history in plaintext until you delete it, which is why what it may read is a fixed list rather than a preference." />

                        <c:SettingsGroup Header="Would this window be read?"
                                         Description="Type a process name and a window title. The answer is the same decision the pipeline makes, run against the same lists.">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Style="{StaticResource JaneTextBox}"
                                             Text="{Binding DeepContext.ProbeProcess, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="Process, e.g. chrome" AutomationProperties.AutomationId="ProbeProcess"
                                             AutomationProperties.Name="Process name to test, for example chrome" />
                                    <TextBox Grid.Column="1"
                                             Style="{StaticResource JaneTextBox}"
                                             Margin="8,0,8,0"
                                             Text="{Binding DeepContext.ProbeTitle, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="Window title, e.g. Chase - Account summary" AutomationProperties.AutomationId="ProbeTitle"
                                             AutomationProperties.Name="Window title to test" />
                                    <Button Grid.Column="2"
                                            Style="{StaticResource JaneButton}"
                                            Content="Test"
                                            AutomationProperties.Name="Test whether Deep Context would read this window"
                                            Click="OnProbeBlocklist" />
                                </Grid>

                                <Border Margin="0,14,0,0"
                                        Padding="12,10,12,10"
                                        CornerRadius="{StaticResource CornerControl}"
                                        Background="{Binding DeepContext.ProbeSeverity, Converter={StaticResource SeverityWash}}"
                                        Visibility="{Binding DeepContext.ProbeMessage, Converter={StaticResource EmptyToCollapsed}}">
                                    <TextBlock Style="{StaticResource Body}"
                                               FontSize="12"
                                               AutomationProperties.LiveSetting="Polite"
                                               Foreground="{Binding DeepContext.ProbeSeverity, Converter={StaticResource SeverityBrush}}"
                                               Text="{Binding DeepContext.ProbeMessage}" />
                                </Border>
                            </StackPanel>
                        </c:SettingsGroup>

                        <c:SettingsGroup Header="Blocked for this session"
                                         Description="Processes whose accessibility provider stopped responding. Jane turns them off for the rest of the session rather than letting one wedged provider cost a thread on every dictation."
                                         Visibility="{Binding DeepContext.HasAutoBlocked, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl ItemsSource="{Binding DeepContext.AutoBlocked}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Style="{StaticResource Label}" FontSize="12" Text="{Binding Key}" />
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Value}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </c:SettingsGroup>

                        <c:SettingsGroup Header="The list itself"
                                         Description="Three layers. A process-name list alone cannot protect web banking -- every site in the world is chrome.exe -- so titles are checked too, and finance and identity words apply only inside a browser, where &quot;bank&quot; is not a variable name.">
                            <StackPanel>
                                <TextBox Style="{StaticResource JaneTextBox}"
                                         Margin="0,0,0,16"
                                         Text="{Binding DeepContext.Filter, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="Search the blocklist" AutomationProperties.AutomationId="BlocklistFilter"
                                         AutomationProperties.Name="Search the blocklist" />

                                <TextBlock Style="{StaticResource SectionHeading}" Text="NEVER READ, WHATEVER THE TITLE" />
                                <ItemsControl ItemsSource="{Binding DeepContext.Processes}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <c:Badge Margin="0,0,6,6" Content="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Style="{StaticResource SectionHeading}" Margin="0,20,0,8" Text="TITLE FRAGMENTS THAT BLOCK EVERYWHERE" />
                                <ItemsControl ItemsSource="{Binding DeepContext.TitleFragments}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <c:Badge Margin="0,0,6,6" Content="{Binding}" Severity="Warning" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Style="{StaticResource SectionHeading}" Margin="0,20,0,8" Text="TITLE FRAGMENTS THAT BLOCK IN A BROWSER ONLY" />
                                <ItemsControl ItemsSource="{Binding DeepContext.BrowserTitleFragments}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <c:Badge Margin="0,0,6,6" Content="{Binding}" Severity="Warning" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Style="{StaticResource SectionHeading}" Margin="0,20,0,8" Text="TREATED AS A BROWSER" />
                                <ItemsControl ItemsSource="{Binding DeepContext.BrowserProcesses}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <c:Badge Margin="0,0,6,6" Content="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <c:StatePanel Margin="0,16,0,0"
                                              Glyph="&#xE721;"
                                              Title="Nothing matches that search"
                                              Description="Clear the box to see the whole list again."
                                              Visibility="{Binding DeepContext.NothingMatches, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </c:SettingsGroup>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================ Vocabulary ======================== -->
            <TabItem Header="Vocabulary"
                     Tag="{x:Static s:SettingsSection.Vocabulary}"
                     AutomationProperties.Name="Custom dictionary">
                <ScrollViewer Style="{StaticResource JaneScrollViewer}">
                    <StackPanel Margin="{StaticResource PadPage}" MaxWidth="880" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource Display}" Text="Vocabulary" />
                        <TextBlock Style="{StaticResource Secondary}"
                                   Margin="0,6,0,20"
                                   Text="Names, jargon and abbreviations the recogniser would otherwise mangle. There is no entry cap; Aqua stops at 800, which is a product decision on a cloud service rather than a technical limit." />

                        <c:SettingsGroup Header="Add a term"
                                         Description="Only the term is required. A pronunciation hint is what the recogniser tends to produce instead; a replacement is what should actually be written.">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Caption}" Margin="0,0,0,5" Text="TERM" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Caption}" Margin="8,0,0,5" Text="HEARD AS (OPTIONAL)" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Caption}" Margin="8,0,0,5" Text="WRITE INSTEAD (OPTIONAL)" />

                                    <TextBox Grid.Row="1" Grid.Column="0"
                                             Style="{StaticResource JaneTextBox}"
                                             Text="{Binding Dictionary.DraftTerm, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="Kubernetes" AutomationProperties.AutomationId="DictionaryTerm"
                                             AutomationProperties.Name="Term to teach Jane" />
                                    <TextBox Grid.Row="1" Grid.Column="1"
                                             Style="{StaticResource JaneTextBox}"
                                             Margin="8,0,0,0"
                                             Text="{Binding Dictionary.DraftPronunciation, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="koober netties" AutomationProperties.AutomationId="DictionaryPronunciation"
                                             AutomationProperties.Name="What the recogniser hears instead, optional" />
                                    <TextBox Grid.Row="1" Grid.Column="2"
                                             Style="{StaticResource JaneTextBox}"
                                             Margin="8,0,0,0"
                                             Text="{Binding Dictionary.DraftReplacement, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="Kubernetes" AutomationProperties.AutomationId="DictionaryReplacement"
                                             AutomationProperties.Name="What should be written instead, optional" />
                                    <Button Grid.Row="1" Grid.Column="3"
                                            Style="{StaticResource JanePrimaryButton}"
                                            Margin="8,0,0,0"
                                            Content="Add"
                                            IsEnabled="{Binding Dictionary.CanAdd}"
                                            AutomationProperties.Name="Add this term to the dictionary"
                                            Click="OnAddDictionaryEntry" />
                                </Grid>

                                <TextBlock Style="{StaticResource Caption}"
                                           Margin="0,12,0,0"
                                           Text="A term with a replacement also stops Jane skipping the language model for that dictation -- a skipped dictation would silently skip your dictionary too." />

                                <TextBlock Style="{StaticResource Body}"
                                           Margin="0,12,0,0"
                                           Foreground="{x:Static c:JaneTheme.Danger}"
                                           AutomationProperties.LiveSetting="Assertive"
                                           Text="{Binding Dictionary.Error}"
                                           Visibility="{Binding Dictionary.Error, Converter={StaticResource EmptyToCollapsed}}" />
                            </StackPanel>
                        </c:SettingsGroup>

                        <c:SettingsGroup Header="Your terms">
                            <StackPanel>
                                <TextBox Style="{StaticResource JaneTextBox}"
                                         Margin="0,0,0,14"
                                         Text="{Binding Dictionary.Filter, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="Search your terms" AutomationProperties.AutomationId="DictionaryFilter"
                                         AutomationProperties.Name="Search your dictionary" />

                                <ItemsControl ItemsSource="{Binding Dictionary.Entries}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,8"
                                                    Padding="14,11,14,11"
                                                    CornerRadius="{StaticResource CornerControl}"
                                                    Background="{x:Static c:JaneTheme.WindowBackground}"
                                                    BorderBrush="{x:Static c:JaneTheme.Border}"
                                                    BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox Grid.Column="0"
                                                              Style="{StaticResource JaneCheckBox}"
                                                              Margin="0,0,12,0"
                                                              VerticalAlignment="Center"
                                                              IsChecked="{Binding Enabled, Mode=OneWay}"
                                                              AutomationProperties.Name="{Binding Term, StringFormat='Use {0} when recognising speech'}"
                                                              Click="OnToggleDictionaryEntry" />

                                                    <StackPanel Grid.Column="1">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Style="{StaticResource Label}" Text="{Binding Term}" />
                                                            <c:Badge Margin="8,0,0,0"
                                                                     VerticalAlignment="Center"
                                                                     Content="replacement"
                                                                     Severity="Success"
                                                                     Visibility="{Binding HasReplacement, Converter={StaticResource BoolToVisibility}}" />
                                                        </StackPanel>
                                                        <!-- Collapsed when there is nothing to say:
                                                             a row reading "heard as" with nothing
                                                             after it looks like a bug. -->
                                                        <TextBlock Style="{StaticResource Caption}"
                                                                   Margin="0,4,0,0"
                                                                   Visibility="{Binding PronunciationHint, Converter={StaticResource EmptyToCollapsed}}"
                                                                   Text="{Binding PronunciationHint, StringFormat='heard as &quot;{0}&quot;'}" />
                                                        <TextBlock Style="{StaticResource Caption}"
                                                                   Margin="0,2,0,0"
                                                                   Visibility="{Binding Replacement, Converter={StaticResource EmptyToCollapsed}}"
                                                                   Text="{Binding Replacement, StringFormat='writes &quot;{0}&quot;'}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource JaneQuietButton}"
                                                                Content="Edit"
                                                                AutomationProperties.Name="{Binding Term, StringFormat='Edit {0}'}"
                                                                Click="OnEditDictionaryEntry" />
                                                        <Button Style="{StaticResource JaneQuietButton}"
                                                                Margin="4,0,0,0"
                                                                Content="Remove"
                                                                AutomationProperties.Name="{Binding Term, StringFormat='Remove {0}'}"
                                                                Click="OnRemoveDictionaryEntry" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <c:StatePanel Glyph="&#xE8FD;"
                                              Title="No terms yet"
                                              Description="Add the words Jane keeps getting wrong -- names, product names, abbreviations. Each one is fed to the recogniser as a biasing hint and named in the language model's prompt."
                                              Visibility="{Binding Dictionary.Entries.Count, Converter={StaticResource EmptyCollectionToVisible}}" />
                            </StackPanel>
                        </c:SettingsGroup>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- =========================== Instructions ======================= -->
            <TabItem Header="Instructions"
                     Tag="{x:Static s:SettingsSection.Instructions}"
                     AutomationProperties.Name="Custom instructions">
                <ScrollViewer Style="{StaticResource JaneScrollViewer}">
                    <StackPanel Margin="{StaticResource PadPage}" MaxWidth="880" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource Display}" Text="Instructions" />
                        <TextBlock Style="{StaticResource Secondary}"
                                   Margin="0,6,0,20"
                                   Text="Plain-English rules about how your text should read. Global rules apply everywhere; per-app rules are added to them, and come last, which is how an instruction-following model resolves a conflict." />

                        <c:SettingsGroup Header="Everywhere"
                                         Description="Applies in every application. A non-empty block here also stops Jane skipping the language model anywhere, because skipping it would skip these rules.">
                            <StackPanel>
                                <TextBox Style="{StaticResource JaneTextArea}"
                                         Text="{Binding Instructions.GlobalText, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="Never use exclamation marks. Prefer short sentences." AutomationProperties.AutomationId="GlobalInstructions"
                                         AutomationProperties.Name="Instructions that apply in every application" />
                                <Button Style="{StaticResource JanePrimaryButton}"
                                        Margin="0,12,0,0"
                                        HorizontalAlignment="Left"
                                        Content="Save"
                                        IsEnabled="{Binding Instructions.GlobalDirty}"
                                        AutomationProperties.Name="Save the global instructions"
                                        Click="OnSaveGlobalInstructions" />
                            </StackPanel>
                        </c:SettingsGroup>

                        <c:SettingsGroup Header="For one application"
                                         Description="Keyed on the process name as Windows reports it. &quot;Code.exe&quot; and &quot;code&quot; are the same application.">
                            <StackPanel>
                                <TextBox Style="{StaticResource JaneTextBox}"
                                         Text="{Binding Instructions.DraftProcess, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="Process name, e.g. code" AutomationProperties.AutomationId="InstructionProcess"
                                         AutomationProperties.Name="Process name these rules apply to" />
                                <TextBox Style="{StaticResource JaneTextArea}"
                                         Margin="0,8,0,0"
                                         MinHeight="80"
                                         Text="{Binding Instructions.DraftText, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="Lower case, no trailing full stop." AutomationProperties.AutomationId="InstructionText"
                                         AutomationProperties.Name="Rules for this application" />
                                <Button Style="{StaticResource JaneButton}"
                                        Margin="0,12,0,0"
                                        HorizontalAlignment="Left"
                                        Content="Add rule"
                                        IsEnabled="{Binding Instructions.CanAddAppRule}"
                                        AutomationProperties.Name="Add these rules for this application"
                                        Click="OnAddAppRule" />

                                <ItemsControl ItemsSource="{Binding Instructions.AppRules}" Margin="0,18,0,0" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,8"
                                                    Padding="14,11,14,11"
                                                    CornerRadius="{StaticResource CornerControl}"
                                                    Background="{x:Static c:JaneTheme.WindowBackground}"
                                                    BorderBrush="{x:Static c:JaneTheme.Border}"
                                                    BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox Grid.Column="0"
                                                              Style="{StaticResource JaneCheckBox}"
                                                              Margin="0,0,12,0"
                                                              VerticalAlignment="Center"
                                                              IsChecked="{Binding Enabled, Mode=OneWay}"
                                                              AutomationProperties.Name="{Binding ProcessName, StringFormat='Apply these rules in {0}'}"
                                                              Click="OnToggleAppRule" />

                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Style="{StaticResource Label}" Text="{Binding ProcessName}" />
                                                        <TextBlock Style="{StaticResource Secondary}" FontSize="12" Margin="0,4,0,0" Text="{Binding Text}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource JaneQuietButton}"
                                                                Content="Edit"
                                                                AutomationProperties.Name="{Binding ProcessName, StringFormat='Edit the rules for {0}'}"
                                                                Click="OnEditAppRule" />
                                                        <Button Style="{StaticResource JaneQuietButton}"
                                                                Margin="4,0,0,0"
                                                                Content="Remove"
                                                                AutomationProperties.Name="{Binding ProcessName, StringFormat='Remove the rules for {0}'}"
                                                                Click="OnRemoveAppRule" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <c:StatePanel Glyph="&#xE8A5;"
                                              Title="No per-application rules"
                                              Description="Useful when one application wants something the rest do not -- terse in a terminal, formal in email. Jane knows which application it is typing into, so it can apply them without being told each time."
                                              Visibility="{Binding Instructions.AppRules.Count, Converter={StaticResource EmptyCollectionToVisible}}" />
                            </StackPanel>
                        </c:SettingsGroup>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================ Appearance ======================== -->
            <TabItem Header="Appearance"
                     Tag="{x:Static s:SettingsSection.Appearance}"
                     AutomationProperties.Name="Overlay appearance">
                <ScrollViewer Style="{StaticResource JaneScrollViewer}">
                    <StackPanel Margin="{StaticResource PadPage}" MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource Display}" Text="Appearance" />
                        <TextBlock Style="{StaticResource Secondary}"
                                   Margin="0,6,0,20"
                                   Text="Jane has no main window. The floating pill is the only thing it puts on screen while you dictate, and it never takes focus -- if it did, your words would go into it instead of your document." />

                        <c:SettingsGroup Header="Floating bar">
                            <StackPanel>
                                <c:SettingRow Header="Show the floating bar"
                                              Description="The pill that appears while Jane is listening, transcribing and typing. With it off, the tray icon is the only feedback Jane gives.">
                                    <CheckBox Style="{StaticResource JaneSwitch}"
                                              IsChecked="{Binding OverlayVisible}"
                                              AutomationProperties.AutomationId="OverlayVisible"
                                              AutomationProperties.Name="Show the floating bar while dictating" />
                                </c:SettingRow>

                                <c:SettingRow Header="Keep it on screen between dictations"
                                              Description="A dimmed pill that rests on screen naming the key you hold, and says so when Jane is paused. With it off, the bar only appears once you are already dictating -- which means nothing on screen tells you Jane is running.">
                                    <CheckBox Style="{StaticResource JaneSwitch}"
                                              IsChecked="{Binding OverlayShowWhenIdle}"
                                              AutomationProperties.AutomationId="OverlayShowWhenIdle"
                                              AutomationProperties.Name="Keep the floating bar on screen between dictations" />
                                </c:SettingRow>

                                <c:SettingRow Header="Position">
                                    <ComboBox Style="{StaticResource JaneComboBox}"
                                              MinWidth="220"
                                              ItemsSource="{Binding Anchors}"
                                              SelectedItem="{Binding OverlayAnchorChoice}"
                                              AutomationProperties.AutomationId="OverlayAnchor"
                                              AutomationProperties.Name="Where the floating bar sits" />
                                </c:SettingRow>

                                <TextBlock Style="{StaticResource Secondary}"
                                           Margin="0,0,0,12"
                                           TextWrapping="Wrap"
                                           Text="{Binding OverlayAnchorChoice.Description}" />

                                <c:SettingRow Header="Show the Deep Context indicator"
                                              Description="Marks the moments Jane read the focused window's text, so reading is never invisible.">
                                    <CheckBox Style="{StaticResource JaneSwitch}"
                                              IsChecked="{Binding OverlayShowContextIndicator}"
                                              AutomationProperties.AutomationId="OverlayContextIndicator"
                                              AutomationProperties.Name="Show the Deep Context indicator on the floating bar" />
                                </c:SettingRow>
                            </StackPanel>
                        </c:SettingsGroup>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================== About ========================== -->
            <TabItem Header="About"
                     Tag="{x:Static s:SettingsSection.About}"
                     AutomationProperties.Name="About Jane and licence attributions">
                <s:AboutView x:Name="About" />
            </TabItem>
        </TabControl>

        <c:ToastHost x:Name="ToastLayer" Grid.Row="1" />
    </Grid>
</Window>
