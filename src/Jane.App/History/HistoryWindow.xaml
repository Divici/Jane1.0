<Window x:Class="Jane.App.History.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Jane.App.Controls"
        xmlns:h="clr-namespace:Jane.App.History"
        Title="Jane history"
        Width="1020"
        Height="740"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        FontSize="13"
        FontFamily="{x:Static c:JaneTheme.UiFont}"
        Foreground="{x:Static c:JaneTheme.TextPrimary}"
        Background="{x:Static c:JaneTheme.WindowBackground}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Jane;component/Controls/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="Root" Background="{x:Static c:JaneTheme.WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- =============================== Header ============================== -->
        <Border Grid.Row="0"
                Background="{x:Static c:JaneTheme.NavBackground}"
                BorderBrush="{x:Static c:JaneTheme.Border}"
                BorderThickness="0,0,0,1"
                Padding="24,18,24,18">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource Display}" Text="History" />
                        <TextBlock Style="{StaticResource Secondary}"
                                   Margin="0,3,0,0"
                                   FontSize="12"
                                   AutomationProperties.LiveSetting="Polite"
                                   Text="{Binding CountDescription}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource JaneButton}"
                                Content="_Refresh"
                                AutomationProperties.Name="Reload the history list"
                                Click="OnRefresh" />
                        <Button Style="{StaticResource JaneDangerButton}"
                                Margin="8,0,0,0"
                                Content="Erase everything"
                                AutomationProperties.AutomationId="EraseEverything"
                                AutomationProperties.Name="Erase every stored dictation"
                                Click="OnAskToErase" />
                    </StackPanel>
                </Grid>

                <!-- The plan requires this said plainly, in the window. It is a banner rather
                     than a tooltip for exactly that reason. -->
                <Border Margin="0,16,0,0"
                        Padding="14,12,14,12"
                        CornerRadius="{StaticResource CornerControl}"
                        Background="{x:Static c:JaneTheme.CautionWash}"
                        BorderBrush="{x:Static c:JaneTheme.Caution}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Body}"
                                   FontSize="12.5"
                                   Foreground="{x:Static c:JaneTheme.TextPrimary}"
                                   Text="{x:Static h:HistoryViewModel.RetentionNotice}" />
                        <TextBlock Style="{StaticResource Mono}"
                                   Margin="0,8,0,0"
                                   FontSize="11.5"
                                   Foreground="{x:Static c:JaneTheme.TextMuted}"
                                   Text="{Binding DatabaseLocation}"
                                   Visibility="{Binding DatabaseLocation, Converter={StaticResource EmptyToCollapsed}}" />
                    </StackPanel>
                </Border>

                <!-- Confirmation strip, in place of a modal that could not say how much is going. -->
                <Border Margin="0,12,0,0"
                        Padding="14,12,14,12"
                        CornerRadius="{StaticResource CornerControl}"
                        Background="{x:Static c:JaneTheme.DangerWash}"
                        BorderBrush="{x:Static c:JaneTheme.Danger}"
                        BorderThickness="1"
                        Visibility="{Binding ConfirmingErase, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0" AutomationProperties.LiveSetting="Assertive">
                            <TextBlock Style="{StaticResource Label}" Text="Erase every stored dictation?" />
                            <TextBlock Style="{StaticResource Secondary}"
                                       Margin="0,4,0,0"
                                       FontSize="12"
                                       Text="This cannot be undone. Jane rebuilds the database afterwards, so the text is removed from the file rather than merely unlinked from it." />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource JaneQuietButton}"
                                    Content="Cancel"
                                    AutomationProperties.Name="Keep the stored dictations"
                                    Click="OnCancelErase" />
                            <Button Style="{StaticResource JaneDangerButton}"
                                    Margin="8,0,0,0"
                                    Content="{Binding CountDescription}"
                                    AutomationProperties.AutomationId="ConfirmErase"
                                    AutomationProperties.Name="Yes, erase every stored dictation"
                                    Click="OnConfirmErase" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- =============================== Toolbar ============================= -->
        <Border Grid.Row="1" Padding="24,16,24,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         x:Name="SearchBox"
                         Style="{StaticResource JaneTextBox}"
                         Tag="Search what you said"
                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.AutomationId="HistorySearch"
                         AutomationProperties.Name="Search everything you have dictated"
                         KeyDown="OnSearchKeyDown" />

                <ComboBox Grid.Column="1"
                          Style="{StaticResource JaneComboBox}"
                          Margin="8,0,0,0"
                          MinWidth="170"
                          Tag="All applications"
                          ItemsSource="{Binding Applications}"
                          SelectedItem="{Binding Application}"
                          AutomationProperties.AutomationId="ApplicationFilter"
                          AutomationProperties.Name="Filter by application"
                          SelectionChanged="OnFilterChanged" />

                <ComboBox Grid.Column="2"
                          Style="{StaticResource JaneComboBox}"
                          Margin="8,0,0,0"
                          MinWidth="190"
                          ItemsSource="{Binding Filters}"
                          SelectedItem="{Binding Filter}"
                          AutomationProperties.AutomationId="ModeFilter"
                          AutomationProperties.Name="Filter by mode and cleanup"
                          SelectionChanged="OnFilterChanged" />

                <Button Grid.Column="3"
                        Style="{StaticResource JaneQuietButton}"
                        Margin="8,0,0,0"
                        Content="Clear"
                        IsEnabled="{Binding IsFiltered}"
                        AutomationProperties.Name="Clear the search and filters"
                        Click="OnClearFilters" />
            </Grid>
        </Border>

        <!-- ================================ List =============================== -->
        <Grid Grid.Row="2">
            <ScrollViewer Style="{StaticResource JaneScrollViewer}" Padding="24,8,18,24">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10"
                                        Padding="16,14,16,14"
                                        CornerRadius="{StaticResource CornerCard}"
                                        Background="{x:Static c:JaneTheme.Surface}"
                                        BorderBrush="{x:Static c:JaneTheme.Border}"
                                        BorderThickness="1"
                                        AutomationProperties.Name="{Binding Announcement}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- WHEN and WHERE, at the same weight as WHAT. -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Label}"
                                                           FontSize="12.5"
                                                           Text="{Binding Application}"
                                                           ToolTip="{Binding WindowTitle}" />
                                                <TextBlock Style="{StaticResource Caption}"
                                                           Margin="8,1,0,0"
                                                           MaxWidth="330"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap"
                                                           Text="{Binding WindowTitle}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Caption}"
                                                           Text="{Binding Relative}"
                                                           ToolTip="{Binding WhenDetail}" />
                                                <TextBlock Style="{StaticResource Mono}"
                                                           Margin="10,0,0,0"
                                                           FontSize="11.5"
                                                           Foreground="{x:Static c:JaneTheme.TextMuted}"
                                                           Text="{Binding When}" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Grid.Row="1"
                                                   Style="{StaticResource Body}"
                                                   Margin="0,10,0,0"
                                                   FontSize="13.5"
                                                   Text="{Binding Text}" />

                                        <Border Grid.Row="2"
                                                Margin="0,10,0,0"
                                                Padding="12,9,12,9"
                                                CornerRadius="{StaticResource CornerControl}"
                                                Background="{x:Static c:JaneTheme.WindowBackground}"
                                                Visibility="{Binding ShowsRawTranscript, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Caption}" Text="AS HEARD, BEFORE CLEANUP" />
                                                <TextBlock Style="{StaticResource Secondary}"
                                                           Margin="0,5,0,0"
                                                           FontSize="12"
                                                           Text="{Binding RawTranscript}" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="3"
                                                Margin="0,10,0,0"
                                                Padding="12,9,12,9"
                                                CornerRadius="{StaticResource CornerControl}"
                                                Background="{x:Static c:JaneTheme.CautionWash}"
                                                Visibility="{Binding HasDeepContext, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Caption}"
                                                           Foreground="{x:Static c:JaneTheme.Caution}"
                                                           Text="ON-SCREEN TEXT DEEP CONTEXT READ, STORED IN PLAINTEXT" />
                                                <TextBlock Style="{StaticResource Secondary}"
                                                           Margin="0,5,0,0"
                                                           FontSize="12"
                                                           MaxHeight="90"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding DeepContext}" />
                                            </StackPanel>
                                        </Border>

                                        <Grid Grid.Row="4" Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <c:Badge Content="{Binding ModeLabel}" />
                                                <c:Badge Margin="6,0,0,0"
                                                         Content="{Binding FormattingLabel}"
                                                         Severity="{Binding FormattingSeverity}" />
                                                <c:Badge Margin="6,0,0,0"
                                                         Content="{Binding InjectionLabel}"
                                                         Severity="{Binding InjectionSeverity}" />
                                                <TextBlock Style="{StaticResource Caption}"
                                                           Margin="10,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding TimingSummary}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Style="{StaticResource JaneQuietButton}"
                                                        Content="Copy"
                                                        AutomationProperties.Name="{Binding Application, StringFormat='Copy the text dictated into {0}'}"
                                                        Click="OnCopy" />
                                                <Button Style="{StaticResource JaneQuietButton}"
                                                        Margin="4,0,0,0"
                                                        Content="Type again"
                                                        AutomationProperties.Name="{Binding Application, StringFormat='Type this again into {0}, if that window is still in front'}"
                                                        Click="OnReinject" />
                                                <Button Style="{StaticResource JaneQuietButton}"
                                                        Margin="4,0,0,0"
                                                        Content="Delete"
                                                        AutomationProperties.Name="{Binding When, StringFormat='Delete the dictation from {0}'}"
                                                        Click="OnDelete" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <c:StatePanel Glyph="&#xE81C;"
                                  Title="{Binding EmptyTitle}"
                                  Description="{Binding EmptyDescription}"
                                  Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

                    <c:StatePanel IsBusy="True"
                                  Title="Reading history"
                                  Description="Jane is loading what you have dictated."
                                  Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

                    <c:StatePanel Glyph="&#xEA39;"
                                  Severity="Error"
                                  Title="History could not be read"
                                  Description="{Binding Error}"
                                  Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </ScrollViewer>

            <c:ToastHost x:Name="ToastLayer" />
        </Grid>
    </Grid>
</Window>
