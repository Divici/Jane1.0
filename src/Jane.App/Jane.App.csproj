<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPublishable>true</IsPublishable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>Jane.App</RootNamespace>
    <AssemblyName>Jane</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="$(HNotifyIconVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jane.Core\Jane.Core.csproj" />
    <ProjectReference Include="..\Jane.Speech\Jane.Speech.csproj" />
    <ProjectReference Include="..\Jane.Llm\Jane.Llm.csproj" />
    <ProjectReference Include="..\Jane.Windows\Jane.Windows.csproj" />
  </ItemGroup>

</Project>
