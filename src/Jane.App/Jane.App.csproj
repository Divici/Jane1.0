<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPublishable>true</IsPublishable>
    <!-- Windows will not start an unsigned uiAccess binary outside %ProgramFiles%, so the
         development manifest declares uiAccess="false" and the shipped one declares "true".
         build/publish.ps1 passes -p:JaneUiAccess=true; nothing else should. -->
    <JaneUiAccess Condition="'$(JaneUiAccess)' == ''">false</JaneUiAccess>
    <ApplicationManifest Condition="'$(JaneUiAccess)' == 'true'">app.uiaccess.manifest</ApplicationManifest>
    <ApplicationManifest Condition="'$(JaneUiAccess)' != 'true'">app.manifest</ApplicationManifest>
    <RootNamespace>Jane.App</RootNamespace>
    <AssemblyName>Jane</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Generated by TrayIconArtwork, not drawn by hand, so the executable's icon and the tray's
         are the same mark. ApplicationIconTests regenerates it and fails if the two have drifted. -->
    <ApplicationIcon>jane.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- So the icon test can regenerate jane.ico from the same code that draws the tray icon and
         assert the committed file still matches it. -->
    <InternalsVisibleTo Include="Jane.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="$(HNotifyIconVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jane.Core\Jane.Core.csproj" />
    <ProjectReference Include="..\Jane.Speech\Jane.Speech.csproj" />
    <ProjectReference Include="..\Jane.Llm\Jane.Llm.csproj" />
    <ProjectReference Include="..\Jane.Windows\Jane.Windows.csproj" />
  </ItemGroup>

</Project>
