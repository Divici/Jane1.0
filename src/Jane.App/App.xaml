<Application x:Class="Jane.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <!-- No StartupUri, and no main window at all. Jane lives in the tray: the only windows it
         ever creates are the non-activating overlay and, from Phase 10, settings and history.
         OnExplicitShutdown is the matching lifetime. With no main window, the default
         OnLastWindowClose would end the process the moment the overlay went idle. -->
    <Application.Resources />
</Application>
