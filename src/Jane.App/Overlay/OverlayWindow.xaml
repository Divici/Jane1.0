<Window x:Class="Jane.App.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:overlay="clr-namespace:Jane.App.Overlay"
        Title="Jane"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        ShowInTaskbar="False"
        Focusable="False"
        IsTabStop="False"
        IsHitTestVisible="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        TextOptions.TextRenderingMode="Grayscale"
        TextOptions.TextFormattingMode="Ideal"
        AutomationProperties.AutomationId="JaneOverlayPill">

    <!-- The 14 px margin is transparent room for the drop shadow, which would otherwise be
         clipped by the window bounds. OverlayPlacement.MarginDip accounts for it, so the pill
         itself lands the intended distance from the work-area edge. -->
    <Grid x:Name="RootLayer" Margin="14" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootShift" Y="6" />
        </Grid.RenderTransform>

        <Border x:Name="Pill"
                Height="28"
                CornerRadius="14"
                Padding="8,0,14,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{x:Static overlay:JanePalette.PillBackground}"
                BorderBrush="{x:Static overlay:JanePalette.PillBorder}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16"
                                  ShadowDepth="3"
                                  Direction="270"
                                  Opacity="0.55"
                                  Color="#FF000000"
                                  RenderingBias="Quality" />
            </Border.Effect>

            <StackPanel x:Name="PillContent" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Dot and waveform occupy the same slot: the waveform replaces the dot while
                     listening, so the pill does not jump width between those two states. -->
                <Grid x:Name="DotHost" Width="20" Height="16" VerticalAlignment="Center">
                    <Ellipse x:Name="StateDot"
                             Width="9"
                             Height="9"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Fill="{x:Static overlay:JanePalette.AccentBrush}" />
                </Grid>

                <overlay:WaveformControl x:Name="Waveform"
                                         Height="16"
                                         Margin="4,0,0,0"
                                         VerticalAlignment="Center"
                                         Visibility="Collapsed"
                                         Fill="{x:Static overlay:JanePalette.AccentBrush}" />

                <TextBlock x:Name="StatusText"
                           Margin="9,0,0,0"
                           VerticalAlignment="Center"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="12.5"
                           FontWeight="Medium"
                           Foreground="{x:Static overlay:JanePalette.PillText}"
                           AutomationProperties.LiveSetting="Polite"
                           Text="Jane" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
