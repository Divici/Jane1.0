<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:c="clr-namespace:Jane.App.Controls">

    <!-- ============================================================================
         Jane's windows. Dark, rounded and restrained, so they read as the same
         product as the overlay pill rather than as a control panel bolted beside it.

         Two rules run through everything below.
         1. Colour is defined once, in JaneTheme / JanePalette, and referenced here
            with x:Static. A hex literal in this file is a colour that will drift.
         2. Every focusable control carries a visible focus ring drawn OUTSIDE its
            own bounds, so keyboard focus never shifts the layout it lands on.
         ============================================================================ -->

    <c:EmptyToCollapsedConverter x:Key="EmptyToCollapsed" />
    <c:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <c:InverseBoolConverter x:Key="InverseBool" />
    <c:EmptyCollectionToVisibleConverter x:Key="EmptyCollectionToVisible" />
    <c:SeverityBrushConverter x:Key="SeverityBrush" />
    <c:SeverityBrushConverter x:Key="SeverityWash" Wash="True" />
    <c:StepReachedConverter x:Key="StepReached" />

    <!-- The spacing scale. Four values, used everywhere; a fifth would be a decision
         somebody has to make again on every screen. -->
    <Thickness x:Key="PadTight">8</Thickness>
    <Thickness x:Key="PadControl">10,7,10,7</Thickness>
    <Thickness x:Key="PadCard">18</Thickness>
    <Thickness x:Key="PadPage">28,24,28,28</Thickness>

    <sys:Double x:Key="RadiusControl">6</sys:Double>
    <CornerRadius x:Key="CornerControl">6</CornerRadius>
    <CornerRadius x:Key="CornerCard">10</CornerRadius>
    <CornerRadius x:Key="CornerPill">999</CornerRadius>

    <!-- ================================ Focus ================================ -->

    <Style x:Key="JaneFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3"
                               RadiusX="8"
                               RadiusY="8"
                               StrokeThickness="2"
                               SnapsToDevicePixels="True"
                               Stroke="{x:Static c:JaneTheme.FocusRing}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================ Text ================================= -->

    <Style TargetType="TextBlock" x:Key="Body">
        <Setter Property="FontFamily" Value="{x:Static c:JaneTheme.UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{x:Static c:JaneTheme.TextPrimary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style TargetType="TextBlock" x:Key="Display" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="21" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style TargetType="TextBlock" x:Key="Title" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="15.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style TargetType="TextBlock" x:Key="Label" BasedOn="{StaticResource Body}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style TargetType="TextBlock" x:Key="Secondary" BasedOn="{StaticResource Body}">
        <Setter Property="Foreground" Value="{x:Static c:JaneTheme.TextSecondary}" />
    </Style>

    <Style TargetType="TextBlock" x:Key="Caption" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{x:Static c:JaneTheme.TextMuted}" />
    </Style>

    <Style TargetType="TextBlock" x:Key="Mono" BasedOn="{StaticResource Body}">
        <Setter Property="FontFamily" Value="{x:Static c:JaneTheme.MonoFont}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style TargetType="TextBlock" x:Key="SectionHeading" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{x:Static c:JaneTheme.TextMuted}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- ============================== Buttons ================================ -->

    <Style TargetType="Button" x:Key="JaneButton">
        <Setter Property="FontFamily" Value="{x:Static c:JaneTheme.UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{x:Static c:JaneTheme.TextPrimary}" />
        <Setter Property="Background" Value="{x:Static c:JaneTheme.Input}" />
        <Setter Property="BorderBrush" Value="{x:Static c:JaneTheme.Border}" />
        <Setter Property="Padding" Value="14,7,14,7" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource JaneFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Shell"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerControl}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="{x:Static c:JaneTheme.InputHover}" />
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{x:Static c:JaneTheme.BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Shell" Property="Opacity" Value="0.75" />
                        </Trigger>

                        <!-- A disabled button loses its colour rather than merely fading. A
                             40%-opacity accent still reads as "the blue one you should press",
                             which is exactly the wrong thing for a button that will not respond. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Shell" Property="Background" Value="{x:Static c:JaneTheme.Input}" />
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{x:Static c:JaneTheme.Border}" />
                            <Setter TargetName="Shell" Property="Opacity" Value="0.6" />
                            <Setter Property="Foreground" Value="{x:Static c:JaneTheme.TextMuted}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" x:Key="JanePrimaryButton" BasedOn="{StaticResource JaneButton}">
        <Setter Property="Background" Value="{x:Static c:JaneTheme.Accent}" />
        <Setter Property="BorderBrush" Value="{x:Static c:JaneTheme.Accent}" />
        <Setter Property="Foreground" Value="#FF0B1220" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style TargetType="Button" x:Key="JaneDangerButton" BasedOn="{StaticResource JaneButton}">
        <Setter Property="Foreground" Value="{x:Static c:JaneTheme.Danger}" />
        <Setter Property="BorderBrush" Value="{x:Static c:JaneTheme.Danger}" />
        <Setter Property="Background" Value="{x:Static c:JaneTheme.DangerWash}" />
    </Style>

    <Style TargetType="Button" x:Key="JaneQuietButton" BasedOn="{StaticResource JaneButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{x:Static c:JaneTheme.TextSecondary}" />
        <Setter Property="Padding" Value="9,5,9,5" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- =============================== Inputs ================================ -->

    <Style TargetType="TextBox" x:Key="JaneTextBox">
        <Setter Property="FontFamily" Value="{x:Static c:JaneTheme.UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{x:Static c:JaneTheme.TextPrimary}" />
        <Setter Property="CaretBrush" Value="{x:Static c:JaneTheme.Accent}" />
        <Setter Property="SelectionBrush" Value="{x:Static c:JaneTheme.Accent}" />
        <Setter Property="Background" Value="{x:Static c:JaneTheme.Input}" />
        <Setter Property="BorderBrush" Value="{x:Static c:JaneTheme.Border}" />
        <Setter Property="Padding" Value="{StaticResource PadControl}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Shell"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerControl}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <!-- The placeholder comes from Tag. A search box with no label and no
                                 placeholder is a rectangle somebody has to guess at, and several
                                 of Jane's boxes (the blocklist probe, the two search fields) are
                                 exactly that shape. -->
                            <TextBlock x:Name="Placeholder"
                                       Margin="{TemplateBinding Padding}"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"
                                       IsHitTestVisible="False"
                                       TextTrimming="CharacterEllipsis"
                                       FontFamily="{x:Static c:JaneTheme.UiFont}"
                                       FontSize="13"
                                       Foreground="{x:Static c:JaneTheme.TextMuted}"
                                       Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                            <!-- No margin here: WPF's own text view already insets by
                                 TextBox.Padding, and adding it again put the caret twice as far
                                 in as the placeholder beside it. -->
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{x:Static c:JaneTheme.BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{x:Static c:JaneTheme.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Shell" Property="Opacity" Value="0.5" />
                        </Trigger>
                        <Trigger Property="AcceptsReturn" Value="True">
                            <Setter TargetName="PART_ContentHost" Property="VerticalAlignment" Value="Stretch" />
                            <Setter TargetName="PART_ContentHost" Property="VerticalScrollBarVisibility" Value="Auto" />
                            <Setter TargetName="Placeholder" Property="VerticalAlignment" Value="Top" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox" x:Key="JaneTextArea" BasedOn="{StaticResource JaneTextBox}">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MinHeight" Value="110" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>

    <!-- A switch rather than a tick box. Every one of Jane's booleans is an on/off
         behaviour rather than a list selection, and a switch states which it is. -->
    <Style TargetType="CheckBox" x:Key="JaneSwitch">
        <Setter Property="FontFamily" Value="{x:Static c:JaneTheme.UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{x:Static c:JaneTheme.TextPrimary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource JaneFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Track"
                                Width="40"
                                Height="22"
                                CornerRadius="{StaticResource CornerPill}"
                                Background="{x:Static c:JaneTheme.Input}"
                                BorderBrush="{x:Static c:JaneTheme.BorderStrong}"
                                BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <Ellipse x:Name="Knob"
                                     Width="14"
                                     Height="14"
                                     HorizontalAlignment="Left"
                                     Margin="3,0,0,0"
                                     Fill="{x:Static c:JaneTheme.TextMuted}" />
                        </Border>
                        <ContentPresenter x:Name="Caption"
                                          Margin="10,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{x:Static c:JaneTheme.Accent}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{x:Static c:JaneTheme.Accent}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                            <Setter TargetName="Knob" Property="Fill" Value="#FF0B1220" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{x:Static c:JaneTheme.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.45" />
                            <Setter TargetName="Caption" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Caption" Property="Margin" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A real tick box, for the places a switch would be wrong: a row in a list. -->
    <Style TargetType="CheckBox" x:Key="JaneCheckBox">
        <Setter Property="FontFamily" Value="{x:Static c:JaneTheme.UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{x:Static c:JaneTheme.TextPrimary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource JaneFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box"
                                Width="17"
                                Height="17"
                                CornerRadius="4"
                                VerticalAlignment="Center"
                                Background="{x:Static c:JaneTheme.Input}"
                                BorderBrush="{x:Static c:JaneTheme.BorderStrong}"
                                BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <Path x:Name="Tick"
                                  Width="10"
                                  Height="10"
                                  Stretch="Uniform"
                                  Visibility="Collapsed"
                                  Fill="#FF0B1220"
                                  Data="M 4,10 L 8,14 L 15,5 L 13.4,3.6 L 8,10.6 L 5.4,8.2 Z" />
                        </Border>
                        <ContentPresenter x:Name="Caption"
                                          Margin="9,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{x:Static c:JaneTheme.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{x:Static c:JaneTheme.Accent}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{x:Static c:JaneTheme.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Opacity" Value="0.45" />
                            <Setter TargetName="Caption" Property="Opacity" Value="0.45" />
                        </Trigger>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Caption" Property="Margin" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton" x:Key="JaneRadio">
        <Setter Property="FontFamily" Value="{x:Static c:JaneTheme.UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{x:Static c:JaneTheme.TextPrimary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource JaneFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="17" Height="17" VerticalAlignment="Top" Margin="0,1,0,0">
                            <Ellipse x:Name="Ring"
                                     Stroke="{x:Static c:JaneTheme.BorderStrong}"
                                     StrokeThickness="1"
                                     Fill="{x:Static c:JaneTheme.Input}" />
                            <Ellipse x:Name="Dot"
                                     Width="8"
                                     Height="8"
                                     Visibility="Collapsed"
                                     Fill="{x:Static c:JaneTheme.Accent}" />
                        </Grid>
                        <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{x:Static c:JaneTheme.Accent}" />
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{x:Static c:JaneTheme.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem" x:Key="JaneComboBoxItem">
        <Setter Property="FontFamily" Value="{x:Static c:JaneTheme.UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{x:Static c:JaneTheme.TextPrimary}" />
        <Setter Property="Padding" Value="10,7,10,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Shell"
                            Background="Transparent"
                            CornerRadius="4"
                            Margin="4,1,4,1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="{x:Static c:JaneTheme.InputHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="{x:Static c:JaneTheme.AccentWash}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox" x:Key="JaneComboBox">
        <Setter Property="FontFamily" Value="{x:Static c:JaneTheme.UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{x:Static c:JaneTheme.TextPrimary}" />
        <Setter Property="Background" Value="{x:Static c:JaneTheme.Input}" />
        <Setter Property="BorderBrush" Value="{x:Static c:JaneTheme.Border}" />
        <Setter Property="Padding" Value="{StaticResource PadControl}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="150" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource JaneFocusVisual}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource JaneComboBoxItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="PART_Toggle"
                                      Focusable="False"
                                      ClickMode="Press"
                                      IsTabStop="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Shell"
                                            Background="{x:Static c:JaneTheme.Input}"
                                            BorderBrush="{x:Static c:JaneTheme.Border}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource CornerControl}"
                                            SnapsToDevicePixels="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter Grid.Column="0" />
                                            <Path Grid.Column="1"
                                                  Width="9"
                                                  Height="6"
                                                  Margin="8,0,12,0"
                                                  VerticalAlignment="Center"
                                                  Stretch="Uniform"
                                                  Fill="{x:Static c:JaneTheme.TextSecondary}"
                                                  Data="M 0,0 L 10,0 L 5,6 Z" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Shell" Property="BorderBrush" Value="{x:Static c:JaneTheme.BorderStrong}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter x:Name="Selected"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />

                        <TextBlock x:Name="Placeholder"
                                   Margin="{TemplateBinding Padding}"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"
                                   IsHitTestVisible="False"
                                   Foreground="{x:Static c:JaneTheme.TextMuted}"
                                   FontFamily="{x:Static c:JaneTheme.UiFont}"
                                   FontSize="13"
                                   Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />

                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               PopupAnimation="Fade"
                               Focusable="False"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Margin="0,4,0,0"
                                    Background="{x:Static c:JaneTheme.Surface}"
                                    BorderBrush="{x:Static c:JaneTheme.BorderStrong}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource CornerControl}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.5" Color="#FF000000" />
                                </Border.Effect>
                                <ScrollViewer Margin="0,4,0,4" SnapsToDevicePixels="True">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SelectedItem" Value="{x:Null}">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Slider" x:Key="JaneSlider">
        <Setter Property="MinWidth" Value="180" />
        <Setter Property="Height" Value="26" />
        <Setter Property="IsSnapToTickEnabled" Value="True" />
        <Setter Property="Foreground" Value="{x:Static c:JaneTheme.Accent}" />
        <Setter Property="Background" Value="{x:Static c:JaneTheme.Input}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource JaneFocusVisual}" />
    </Style>

    <Style TargetType="ProgressBar" x:Key="JaneProgress">
        <Setter Property="Height" Value="6" />
        <Setter Property="Foreground" Value="{x:Static c:JaneTheme.Accent}" />
        <Setter Property="Background" Value="{x:Static c:JaneTheme.Input}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource CornerPill}"
                            SnapsToDevicePixels="True">
                        <Grid ClipToBounds="True">
                            <Rectangle x:Name="PART_Track" />
                            <Rectangle x:Name="PART_Indicator"
                                       HorizontalAlignment="Left"
                                       RadiusX="3"
                                       RadiusY="3"
                                       Fill="{TemplateBinding Foreground}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Fill" Value="{x:Static c:JaneTheme.Accent}" />
                            <Setter TargetName="PART_Indicator" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================= Scrolling =============================== -->

    <Style TargetType="Thumb" x:Key="JaneScrollThumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{x:Static c:JaneTheme.BorderStrong}"
                            CornerRadius="{StaticResource CornerPill}"
                            Margin="3,0,3,0" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar" x:Key="JaneScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource JaneScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" IsTabStop="False" />
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" IsTabStop="False" />
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollViewer" x:Key="JaneScrollViewer">
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- Padding as a margin on the presenter, which the default template does
                             not do: without it a list inside a padded scroll viewer runs to the
                             window edge while the header above it is inset. -->
                        <ScrollContentPresenter Grid.Column="0"
                                                Margin="{TemplateBinding Padding}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}" />
                        <ScrollBar Grid.Column="1"
                                   x:Name="PART_VerticalScrollBar"
                                   Style="{StaticResource JaneScrollBar}"
                                   Orientation="Vertical"
                                   Minimum="0"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== Lists ================================== -->

    <Style TargetType="ListBox" x:Key="JaneListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{x:Static c:JaneTheme.TextPrimary}" />
        <Setter Property="FontFamily" Value="{x:Static c:JaneTheme.UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <Style TargetType="ListBoxItem" x:Key="JaneListItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource JaneFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Shell"
                            Background="{x:Static c:JaneTheme.Surface}"
                            BorderBrush="{x:Static c:JaneTheme.Border}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerControl}"
                            Padding="14,11,14,11"
                            SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{x:Static c:JaneTheme.BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{x:Static c:JaneTheme.Accent}" />
                            <Setter TargetName="Shell" Property="Background" Value="{x:Static c:JaneTheme.AccentWash}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================= Left navigation rail ========================= -->

    <Style TargetType="TabItem" x:Key="JaneNavItem">
        <Setter Property="FontFamily" Value="{x:Static c:JaneTheme.UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{x:Static c:JaneTheme.TextSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource JaneFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid x:Name="Shell"
                          Background="Transparent"
                          Margin="8,1,8,1">
                        <Border x:Name="Fill"
                                CornerRadius="{StaticResource CornerControl}"
                                Background="Transparent"
                                SnapsToDevicePixels="True" />
                        <Border x:Name="Marker"
                                Width="3"
                                Height="18"
                                HorizontalAlignment="Left"
                                Margin="0"
                                CornerRadius="{StaticResource CornerPill}"
                                Background="Transparent" />
                        <ContentPresenter ContentSource="Header"
                                          Margin="16,9,12,9"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{x:Static c:JaneTheme.Surface}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{x:Static c:JaneTheme.AccentWash}" />
                            <Setter TargetName="Marker" Property="Background" Value="{x:Static c:JaneTheme.Accent}" />
                            <Setter Property="Foreground" Value="{x:Static c:JaneTheme.TextPrimary}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabControl" x:Key="JaneNav">
        <Setter Property="TabStripPlacement" Value="Left" />
        <Setter Property="Background" Value="{x:Static c:JaneTheme.WindowBackground}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource JaneNavItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="216" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{x:Static c:JaneTheme.NavBackground}"
                                BorderBrush="{x:Static c:JaneTheme.Border}"
                                BorderThickness="0,0,1,0">
                            <ScrollViewer Style="{StaticResource JaneScrollViewer}" Margin="0,10,0,10">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.TabNavigation="Cycle" />
                            </ScrollViewer>
                        </Border>

                        <Border Grid.Column="1" Background="{TemplateBinding Background}">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A tab control with no strip at all: the wizard's own rail says where you are, and two
         navigations for one position is one too many. Selection, content swapping and the
         automation tree still come from TabControl rather than from a hand-rolled switch. -->
    <Style TargetType="TabItem" x:Key="JaneStepItem">
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
    </Style>

    <Style TargetType="TabControl" x:Key="JaneStepHost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource JaneStepItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================== Jane's own controls ======================== -->

    <Style TargetType="{x:Type c:SettingsGroup}">
        <Setter Property="Margin" Value="0,0,0,18" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:SettingsGroup}">
                    <Border Background="{x:Static c:JaneTheme.Surface}"
                            BorderBrush="{x:Static c:JaneTheme.Border}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerCard}"
                            Padding="{StaticResource PadCard}"
                            SnapsToDevicePixels="True">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Title}"
                                       Text="{TemplateBinding Header}"
                                       Visibility="{Binding Header, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EmptyToCollapsed}}" />
                            <TextBlock Style="{StaticResource Secondary}"
                                       Margin="0,4,0,0"
                                       Text="{TemplateBinding Description}"
                                       Visibility="{Binding Description, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EmptyToCollapsed}}" />
                            <ContentPresenter Margin="0,14,0,0" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type c:SettingRow}">
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:SettingRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="140" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Label}" Text="{TemplateBinding Header}" />
                            <TextBlock Style="{StaticResource Secondary}"
                                       Margin="0,3,0,0"
                                       FontSize="12"
                                       Text="{TemplateBinding Description}"
                                       Visibility="{Binding Description, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EmptyToCollapsed}}" />
                            <Border Margin="0,7,0,0"
                                    CornerRadius="4"
                                    Padding="8,5,8,5"
                                    Background="{Binding NoteSeverity, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource SeverityWash}}"
                                    Visibility="{Binding Note, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EmptyToCollapsed}}">
                                <TextBlock Style="{StaticResource Body}"
                                           FontSize="12"
                                           AutomationProperties.LiveSetting="Polite"
                                           Foreground="{Binding NoteSeverity, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource SeverityBrush}}"
                                           Text="{TemplateBinding Note}" />
                            </Border>
                        </StackPanel>

                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type c:Badge}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:Badge}">
                    <Border CornerRadius="{StaticResource CornerPill}"
                            Padding="8,2,8,3"
                            Background="{Binding Severity, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource SeverityWash}}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter TextBlock.FontFamily="{x:Static c:JaneTheme.UiFont}"
                                          TextBlock.FontSize="11"
                                          TextBlock.FontWeight="SemiBold"
                                          TextBlock.Foreground="{Binding Severity, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource SeverityBrush}}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type c:StatePanel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:StatePanel}">
                    <Border Background="{x:Static c:JaneTheme.Surface}"
                            BorderBrush="{x:Static c:JaneTheme.Border}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerCard}"
                            Padding="28,32,28,32"
                            SnapsToDevicePixels="True">
                        <StackPanel HorizontalAlignment="Center" MaxWidth="420">
                            <TextBlock x:Name="GlyphText"
                                       HorizontalAlignment="Center"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="26"
                                       Margin="0,0,0,12"
                                       Foreground="{Binding Severity, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource SeverityBrush}}"
                                       Text="{TemplateBinding Glyph}" />
                            <ProgressBar x:Name="Busy"
                                         Style="{StaticResource JaneProgress}"
                                         Width="160"
                                         Margin="0,4,0,16"
                                         Visibility="Collapsed"
                                         IsIndeterminate="True" />
                            <TextBlock Style="{StaticResource Title}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       Text="{TemplateBinding Title}" />
                            <TextBlock Style="{StaticResource Secondary}"
                                       Margin="0,6,0,0"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       Text="{TemplateBinding Description}"
                                       Visibility="{Binding Description, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EmptyToCollapsed}}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsBusy" Value="True">
                            <Setter TargetName="GlyphText" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Busy" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type c:ToastHost}">
        <Setter Property="IsHitTestVisible" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="0,0,20,20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:ToastHost}">
                    <ItemsControl ItemsSource="{Binding Messages, RelativeSource={RelativeSource TemplatedParent}}"
                                  Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border MaxWidth="400"
                                        Margin="0,8,0,0"
                                        Background="{x:Static c:JaneTheme.Surface}"
                                        BorderThickness="1,1,1,1"
                                        BorderBrush="{Binding Severity, Converter={StaticResource SeverityBrush}}"
                                        CornerRadius="{StaticResource CornerControl}"
                                        Padding="14,11,10,11">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="20" ShadowDepth="5" Direction="270" Opacity="0.55" Color="#FF000000" />
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="3"
                                                Margin="0,0,12,0"
                                                CornerRadius="{StaticResource CornerPill}"
                                                Background="{Binding Severity, Converter={StaticResource SeverityBrush}}" />

                                        <StackPanel Grid.Column="1" AutomationProperties.LiveSetting="Assertive">
                                            <TextBlock Style="{StaticResource Label}" Text="{Binding Text}" />
                                            <TextBlock Style="{StaticResource Secondary}"
                                                       Margin="0,4,0,0"
                                                       FontSize="12"
                                                       Text="{Binding Detail}"
                                                       Visibility="{Binding Detail, Converter={StaticResource EmptyToCollapsed}}" />
                                        </StackPanel>

                                        <Button Grid.Column="2"
                                                Style="{StaticResource JaneQuietButton}"
                                                VerticalAlignment="Top"
                                                Margin="8,-2,0,0"
                                                Content="&#xE711;"
                                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                FontSize="10"
                                                AutomationProperties.Name="Dismiss this message"
                                                CommandParameter="{Binding}"
                                                Command="{Binding DismissCommand, RelativeSource={RelativeSource AncestorType={x:Type c:ToastHost}}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Window shell ============================= -->

    <Style TargetType="Window" x:Key="JaneWindow">
        <Setter Property="Background" Value="{x:Static c:JaneTheme.WindowBackground}" />
        <Setter Property="Foreground" Value="{x:Static c:JaneTheme.TextPrimary}" />
        <Setter Property="FontFamily" Value="{x:Static c:JaneTheme.UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <!-- A separator that is a hairline rather than a groove. -->
    <Style TargetType="Border" x:Key="Divider">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{x:Static c:JaneTheme.Border}" />
        <Setter Property="Margin" Value="0,14,0,14" />
    </Style>

</ResourceDictionary>
