<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Windows TFM because `route` exercises the real GpuGovernor (NVML + window geometry),
         `doctor` enumerates real audio endpoints, and the fixture builder drives Windows SAPI. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Jane.Bench</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows' own text-to-speech, used only to synthesise the fixture corpus so `bench` can
         run start to finish with stdin closed. Never on the dictation path. -->
    <PackageReference Include="System.Speech" Version="$(SystemSpeechVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jane.Core\Jane.Core.csproj" />
    <ProjectReference Include="..\Jane.Speech\Jane.Speech.csproj" />
    <ProjectReference Include="..\Jane.Llm\Jane.Llm.csproj" />
    <ProjectReference Include="..\Jane.Windows\Jane.Windows.csproj" />
  </ItemGroup>

</Project>
