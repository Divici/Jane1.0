<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- The meta-package and the per-RID runtime package version independently upstream, so
         both are pinned and SherpaNativeProbe asserts at load time that the native library
         actually resolves. A mismatched pair fails at first P/Invoke, not at restore. -->
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="$(SherpaOnnxVersion)" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-x64" Version="$(SherpaOnnxRuntimeVersion)" />

    <!-- Second ASR engine, benched against Parakeet so the extrapolated CPU figure is validated
         rather than trusted. CPU runtime only: every GPU path is compromised on this machine. -->
    <PackageReference Include="Whisper.net" Version="$(WhisperNetVersion)" />
    <PackageReference Include="Whisper.net.Runtime" Version="$(WhisperNetVersion)" />

    <!-- sherpa-onnx ships its models as .tar.bz2 and .NET has no bzip2 in the box. -->
    <PackageReference Include="SharpZipLib" Version="$(SharpZipLibVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jane.Core\Jane.Core.csproj" />
  </ItemGroup>

</Project>
