<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0, NOT net10.0-windows. Jane.Core holds the orchestrator, the state machine,
         the formatter and every policy decision; keeping it off the Windows TFM is what
         makes those unit-testable without a desktop session, and DoctorTests asserts it. -->
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- Phase 10's store. Microsoft.Data.Sqlite is deliberately the only data dependency:
         it is cross-platform managed code over a bundled e_sqlite3 native, so Jane.Core stays
         off the Windows TFM and DoctorTests keeps passing. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="$(MicrosoftDataSqliteVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- A handful of test seams stay internal rather than widening the public surface: the
         orchestrator's pending-audio field, for instance, exists only so a test can prove the
         buffer is released on every terminal path. -->
    <InternalsVisibleTo Include="Jane.Core.Tests" />
    <InternalsVisibleTo Include="Jane.Eval" />
  </ItemGroup>

</Project>
